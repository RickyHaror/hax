{
  "name": "hax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hax: a pretend-computer escape room that teaches kids computer basics and ethical hacking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:reading": "node scripts/checks/reading-level.mjs",
    "check:links": "node scripts/checks/no-external.mjs",
    "check:copy": "node scripts/checks/no-dashes.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "gate": "bash scripts/orchestration/gate.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.13",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.158.0"
  }
}
